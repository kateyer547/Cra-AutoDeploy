# Copie réelle : ~/cra/.env sur le Raspberry Pi (chmod 600), hors dépôt.
GITHUB_OWNER=rbfrg
IMAGE_TAG=latest
# Jeton du tunnel Cloudflare dédié (Zero Trust > Networks > Tunnels > Docker).
TUNNEL_TOKEN=
# Origines autorisées pour les écritures (CSRF, 17.2) : l'adresse publique du site.
APP_ORIGIN=https://cra.example.com
