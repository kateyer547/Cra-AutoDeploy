# Modèle : la copie réelle vit sur le Pi (~/cra/Caddyfile), hors dépôt.
# Remplacer les domaines et le hash (docker run --rm -it caddy:2 caddy hash-password).
# Le préfixe http:// désactive le HTTPS automatique : Cloudflare termine le TLS,
# le tunnel envoie le hostname vers http://caddy:80.

http://cra.example.com {
    encode zstd gzip

    # En-têtes de sécurité, jusqu'à ce que l'application les émette (tranche 5, 17.7).
    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }

    # /health reste public : la CI vérifie la version déployée.
    @health path /health
    handle @health {
        reverse_proxy app:8080
    }

    # Transitoire jusqu'à la tranche « Accès sécurisé » (17.4).
    handle {
        basic_auth {
            moi COLLER_ICI_LE_HASH
        }
        reverse_proxy app:8080
    }
}
